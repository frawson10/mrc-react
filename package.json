{
  "name": "mrc-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "dev:testing": "VITE_SITE_BUILD_TARGET=testing vite",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js --noEmit -p tsconfig.app.json",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "npm run validate:content && npm run typecheck && vite build && npm run prerender:production",
    "build:production": "VITE_SITE_BUILD_TARGET=production npm run build",
    "build:testing": "VITE_SITE_BUILD_TARGET=testing npm run build",
    "prerender:production": "node scripts/prerender-production.mjs",
    "test": "node scripts/run-tests.mjs",
    "start": "node server.js",
    "preview": "vite preview",
    "verify:build": "node scripts/verify-build.mjs",
    "format": "prettier --write src scripts tests server.js vite.config.ts"
  },
  "dependencies": {
    "dompurify": "3.4.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "24.1.3",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vite": "6.4.1"
  }
}
